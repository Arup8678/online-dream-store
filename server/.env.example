PORT=4000
# Secret used to sign login cookies - set to a long random string
JWT_SECRET=
# First-run admin account (only used when no admin exists yet)
ADMIN_EMAIL=admin@dreamplace.local
ADMIN_PASSWORD=admin123
# Optional: real Razorpay keys. Without them a local test gateway is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set to 1 when serving over HTTPS so cookies are Secure
COOKIE_SECURE=
